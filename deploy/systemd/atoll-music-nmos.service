[Unit]
Description=Atoll music channel NMOS registrar (IS-04 senders + SDP server)
After=network-online.target docker.service atoll-music.service
Wants=network-online.target
[Service]
User=david
WorkingDirectory=/home/david/pi-nmos-st2110/pc
ExecStart=/usr/bin/python3 /home/david/pi-nmos-st2110/pc/music-nmos.py
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target

[Unit]
Description=Atoll JPEG XS viewer (ST 2110-22 codec, local enc->dec MJPEG) :8100
After=network-online.target
Wants=network-online.target
[Service]
User=david
WorkingDirectory=/home/david/pi-nmos-st2110/pc
ExecStart=/usr/bin/python3 -u /home/david/pi-nmos-st2110/pc/jxs-web.py
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target

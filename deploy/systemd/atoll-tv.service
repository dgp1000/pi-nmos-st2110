[Unit]
Description=Atoll live-TV bridge (HDHomeRun -> HEVC tile group)
After=network-online.target
Wants=network-online.target
[Service]
User=david
WorkingDirectory=/home/david/pi-nmos-st2110/pc
ExecStart=/usr/bin/python3 /home/david/pi-nmos-st2110/pc/tv-send-seamless.py
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target

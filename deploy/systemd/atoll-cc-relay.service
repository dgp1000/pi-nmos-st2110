[Unit]
Description=Atoll real closed-caption relay (tuner -> ccextractor -> cc-input -> ST 2110-40)
After=network.target

[Service]
User=david
WorkingDirectory=/home/david/pi-nmos-st2110/pc
ExecStart=/bin/bash -c "source ./atoll.conf && ATOLL_RUN=${ATOLL_RUN:-/home/david/atoll-run} HDHR_HOST=$HDHR_HOST exec python3 cc-relay.py"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

[Unit]
Description=Atoll Pi ST 2110 NMOS registrar + SDP server (raw video + L24 audio) -> :8095
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/david/pi-nmos-st2110/pc/pi-nmos.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

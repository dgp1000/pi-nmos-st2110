[Unit]
Description=Atoll AMWA IS-11 Stream Compatibility Management API (+ self-hosted IS-04 node / IS-05)
After=network-online.target
Wants=network-online.target

[Service]
User=david
WorkingDirectory=/home/david/pi-nmos-st2110/pc
ExecStart=/usr/bin/python3 -u /home/david/pi-nmos-st2110/pc/is11-nmos.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

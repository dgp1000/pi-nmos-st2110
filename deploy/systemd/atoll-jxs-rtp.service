[Unit]
Description=Atoll JPEG XS ST 2110-22 sender (RFC 9134 video/jxsv over RTP)
After=network-online.target
Wants=network-online.target

[Service]
User=david
WorkingDirectory=/home/david/pi-nmos-st2110/pc
ExecStart=/usr/bin/python3 -u /home/david/pi-nmos-st2110/pc/jxs-rtp-send.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

[Unit]
Description=Atoll JPEG XS NMOS registrar + SDP (IS-04 / BCP-006-01 video/jxsv)
After=network-online.target
Wants=network-online.target

[Service]
User=david
WorkingDirectory=/home/david/pi-nmos-st2110/pc
ExecStart=/usr/bin/python3 -u /home/david/pi-nmos-st2110/pc/jxs-nmos.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

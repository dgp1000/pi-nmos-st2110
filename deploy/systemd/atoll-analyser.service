[Unit]
Description=Atoll island flow analyser (per-flow pps/bitrate/RTP loss) -> :8101
After=network-online.target
Wants=network-online.target
[Service]
User=david
WorkingDirectory=/home/david/pi-nmos-st2110/pc
ExecStart=/usr/bin/python3 /home/david/pi-nmos-st2110/pc/analyser.py
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target

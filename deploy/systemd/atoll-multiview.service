[Unit]
Description=Atoll multiview MJPEG server (:8099, browser-viewable 2x2)
After=network-online.target
Wants=network-online.target
[Service]
User=david
WorkingDirectory=/home/david/pi-nmos-st2110/pc
ExecStart=/usr/bin/python3 -u /home/david/pi-nmos-st2110/pc/multiview-web.py
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target

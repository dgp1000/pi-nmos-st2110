[Unit]
Description=Atoll AMWA IS-12 NMOS Control Protocol + MS-05-02 device model (ncp WebSocket)
After=network-online.target
Wants=network-online.target

[Service]
User=david
WorkingDirectory=/home/david/pi-nmos-st2110/pc
ExecStart=/usr/bin/python3 -u /home/david/pi-nmos-st2110/pc/is12-nmos.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

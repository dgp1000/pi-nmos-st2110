[Unit]
Description=Atoll Program Out (routable NMOS receiver, IS-05 Connection API)
After=network-online.target docker.service
Wants=network-online.target
[Service]
User=david
WorkingDirectory=/home/david/pi-nmos-st2110/pc
ExecStart=/usr/bin/python3 /home/david/pi-nmos-st2110/pc/program-out.py
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target

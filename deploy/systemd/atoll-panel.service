[Unit]
Description=Atoll IS-05 switch panel + IS-04/05 inspector (monitor-web.py :8096)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=david
WorkingDirectory=/home/david/pi-nmos-st2110/pc
ExecStart=/usr/bin/python3 -u /home/david/pi-nmos-st2110/pc/monitor-web.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
